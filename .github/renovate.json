{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "dependencyDashboardAutoclose": true,
  "timezone": "Europe/Berlin",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 1,
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "npm"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Deno import map npm: specifiers in deno.jsonc",
      "managerFilePatterns": [
        "/deno\\.jsonc?$/"
      ],
      "matchStrings": [
        "\"npm:(?<depName>(?:@[^/]+/)?[^@]+)@(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Deno import map jsr: specifiers in deno.jsonc",
      "managerFilePatterns": [
        "/deno\\.jsonc?$/"
      ],
      "matchStrings": [
        "\"jsr:(?<depName>@[^@/]+/[^@/@]+)@(?<currentValue>[^\"/@]+)"
      ],
      "datasourceTemplate": "jsr"
    }
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex",
        "npm"
      ],
      "addLabels": [
        "npm"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "ci"
      ]
    },
    {
      "description": "Auto-merge Deno package patch and minor updates - low blast radius",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    }
  ],
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  }
}
