{
    "name": "@vrtmrz/livesync-commonlib",
    "version": "0.2.1",
    "description": "Shared data, storage, and replication primitives for Self-hosted LiveSync clients.",
    "private": true,
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vrtmrz/livesync-commonlib.git"
    },
    "imports": {
        "#worker": {
            "browser": "./src/worker/bgWorker.ts",
            "deno": "./src/worker/bgWorker.direct.ts",
            "node": "./src/worker/bgWorker.direct.ts",
            "default": "./src/worker/bgWorker.direct.ts"
        }
    },
    "scripts": {
        "build:package": "node _tools/build-package.mjs",
        "check:boundary": "node _tools/check-package-boundary.mjs",
        "check:package": "node _tools/check-packed-package.mjs",
        "check:types": "tsc --noEmit -p tsconfig.check.json",
        "test": "vitest run",
        "test:boundary": "node --test _tools/check-package-boundary.test.mjs _tools/compatibility-classification.test.mjs _tools/update-downstream-import-inventory.test.mjs",
        "test:contract:context": "vitest run src/services/base/ServiceContext.unit.spec.ts",
        "test:contract:platform-storage": "vitest run src/platform/storage.contract.unit.test.ts",
        "test:contract:standard-io": "vitest run src/platform/standardIo.unit.spec.ts",
        "test:contracts": "vitest run src/services/base/ServiceContext.unit.spec.ts src/platform/storage.contract.unit.test.ts src/platform/standardIo.unit.spec.ts",
        "test:integration": "node _tools/run-integration-tests.mjs",
        "test:integration:managed": "node _tools/run-integration-tests.mjs --manage-services",
        "test:package": "node _tools/run-package-test.mjs",
        "test:release": "node --test _tools/prepare-github-release.test.mjs _tools/validate-release-selection.test.mjs",
        "update:downstream-import-inventory": "node _tools/update-downstream-import-inventory.mjs",
        "verify:package": "npm run check:types && npm test && npm run test:boundary && npm run test:release && npm run check:boundary && npm run test:package"
    },
    "dependencies": {
        "@aws-crypto/sha256-js": "5.2.0",
        "@aws-sdk/client-s3": "^3.1152.0",
        "@smithy/fetch-http-handler": "^5.8.0",
        "@smithy/md5-js": "^4.5.2",
        "@smithy/middleware-apply-body-checksum": "^4.6.3",
        "@smithy/types": "^4.19.0",
        "@smithy/util-retry": "^4.6.2",
        "@trystero-p2p/nostr": "^0.26.0",
        "@vrtmrz/value-store": "0.1.0",
        "diff-match-patch": "^1.0.5",
        "events": "^3.3.0",
        "fflate": "^0.8.3",
        "idb": "^8.0.4",
        "markdown-it": "^15.0.2",
        "minimatch": "^10.2.6",
        "octagonal-wheels": "^0.1.55",
        "pouchdb-adapter-http": "^9.0.0",
        "pouchdb-adapter-idb": "^9.0.0",
        "pouchdb-adapter-indexeddb": "^9.0.0",
        "pouchdb-adapter-memory": "^9.0.0",
        "pouchdb-checkpointer": "9.0.0",
        "pouchdb-core": "^9.0.0",
        "pouchdb-errors": "^9.0.0",
        "pouchdb-find": "^9.0.0",
        "pouchdb-generate-replication-id": "9.0.0",
        "pouchdb-mapreduce": "^9.0.0",
        "pouchdb-merge": "^9.0.0",
        "pouchdb-replication": "^9.0.0",
        "pouchdb-utils": "^9.0.0",
        "qrcode-generator": "^2.0.4",
        "transform-pouch": "^2.0.0",
        "xxhash-wasm-102": "npm:xxhash-wasm@^1.1.0",
        "diff": "^9.0.0",
        "hash-wasm": "^4.12.0"
    },
    "devDependencies": {
        "@smithy/protocol-http": "^5.6.2",
        "@types/diff-match-patch": "^1.0.36",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^26.6.5",
        "@types/pouchdb": "^6.4.2",
        "@types/pouchdb-adapter-http": "^6.1.6",
        "@types/pouchdb-adapter-idb": "^6.1.7",
        "@types/pouchdb-core": "^7.0.15",
        "@types/pouchdb-mapreduce": "^6.1.10",
        "@types/transform-pouch": "^1.0.6",
        "esbuild": "0.28.2",
        "esbuild-plugin-inline-worker": "^0.1.1",
        "fake-indexeddb": "^6.2.5",
        "prettier": "4.0.0-alpha.13",
        "svelte": "5.57.2",
        "tinyglobby": "^0.2.17",
        "typescript": "7.0.2",
        "vitest": "^5.0.4",
        "typescript-compiler-api": "npm:typescript@~6.0.3"
    },
    "engines": {
        "node": ">=20"
    }
}
